NODE_ENV=production
PORT=5000

MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/digsign?retryWrites=true&w=majority

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
RESET_TOKEN_EXPIRES_IN=1h

CORS_ORIGIN=https://your-vercel-app.vercel.app
FRONTEND_URL=https://your-vercel-app.vercel.app

UPLOAD_DIR=/app/storage
MAX_FILE_SIZE_MB=25

SEED_ADMIN_EMAIL=admin@digsign.local
SEED_ADMIN_PASSWORD=change-this-admin-password
SEED_USER_EMAIL=demo@digsign.local
SEED_USER_PASSWORD=change-this-user-password
