# ---------- Server ----------
NODE_ENV=development
PORT=5000

# ---------- Database ----------
MONGODB_URI=mongodb://127.0.0.1:27017/digsign

# ---------- Auth ----------
# Use a long random string in production (e.g. `openssl rand -base64 64`)
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Token used for password reset / email verify links (separate from auth JWT)
RESET_TOKEN_EXPIRES_IN=1h

# ---------- CORS / Frontend ----------
CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# ---------- File Storage ----------
# Local directory where uploaded & signed PDFs are stored
UPLOAD_DIR=./storage
MAX_FILE_SIZE_MB=25

# ---------- Bootstrap Admin (used by `npm run seed`) ----------
SEED_ADMIN_EMAIL=admin@digsign.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_USER_EMAIL=demo@digsign.local
SEED_USER_PASSWORD=Demo@12345
