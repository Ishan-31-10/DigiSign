# Root .env for local Docker testing only.
# Do not upload this file to Vercel/Render. Add these values in each platform dashboard.

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Local Docker MongoDB:
MONGODB_URI=mongodb://mongo:27017/digsign

# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/digsign?retryWrites=true&w=majority

CORS_ORIGIN=http://localhost:3000
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=https://digisign-pbcb.onrender.com/api

MAX_FILE_SIZE_MB=25
